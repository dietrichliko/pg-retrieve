# Copy to .env (git-ignored) and fill in. Loaded by direnv through .envrc.
# libpq variables, used by psql and by psycopg. CERN values are the reference deployment.
PGHOST=dbod-<instance>.cern.ch
PGPORT=<port>
PGUSER=admin
PGDATABASE=postgres
PGSSLMODE=require
PGGSSENCMODE=disable
PGPASSWORD=<password>

# OpenAI-compatible model endpoint (CERN AI gateway). Key from
# https://aigw.cern.ch/ui/?page=api-keys (pick the team, then "All Team Models").
# Only on-premises gateway models may see corpus content.
# Names as read by the probe-model-endpoint skill; the service config section of
# docs/spec.md will adopt or rename them.
# CERN: MODEL_BASE_URL=https://aigw.cern.ch/, EMBED_MODELS=embeddinggemma-300m,
# CHAT_MODEL=qwen3.8-27b-fp16 (or a smaller one such as gemma-4-12b).
MODEL_BASE_URL=<base-url>
MODEL_API_KEY=<api-key>
EMBED_MODELS=<embedding-model>
CHAT_MODEL=<chat-model>
