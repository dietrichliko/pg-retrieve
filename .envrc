# direnv: sync and activate the uv-managed virtualenv.
# uv is installed outside the project (https://docs.astral.sh/uv/).
watch_file pyproject.toml uv.lock .python-version
uv sync --quiet
export VIRTUAL_ENV="$PWD/.venv"
PATH_add .venv/bin

# Local settings and secrets (not committed).
dotenv_if_exists .env
source_env_if_exists .envrc.local
